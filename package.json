{
  "name": "whaletalk",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 本机 AI 虚拟角色直播工具(方案实施 P0)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "start:reset-access": "tsx src/server/main.ts --reset-access",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "gen:test-assets": "node scripts/gen-test-assets.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "msedge-tts": "^2.1.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
